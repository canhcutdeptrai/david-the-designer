+  <script>
+    // ── Người giữ ghế: bảng nhiều dòng (sd-table addable) ─────────────────────────────
+    // Rule ngày (requirements.md 2026-06-23, màn tạo): Ngày bắt đầu chọn quá khứ / hiện tại / tương lai;
+    // Ngày kết thúc chỉ từ ngày hiện tại trở đi (và sau Ngày bắt đầu). Chặn trực tiếp trên lịch bằng `min`.
+    var HOLDER_OPTIONS = [
+      'Nguyễn Văn A - nguyenvana@onemount.com',
+      'Trần Thị B - tranthib@onemount.com',
+      'Lê Văn C - levanc@onemount.com'
+    ];
+    var holderRows = [{ holder: '', from: '', to: '' }];
+
+    function pad2(n) { return (n < 10 ? '0' : '') + n; }
+    function toCanon(d) { return d.getFullYear() + '/' + pad2(d.getMonth() + 1) + '/' + pad2(d.getDate()); }
+    function todayCanon() { return toCanon(new Date()); }
+    function addDays(canon, n) {
+      var p = String(canon).split(/[\/\-]/);
+      return toCanon(new Date(+p[0], +p[1] - 1, +p[2] + n));
+    }
+    function maxCanon(a, b) { return !a ? b : (!b ? a : (a > b ? a : b)); }
+    function escAttrH(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/'/g, '&#39;').replace(/"/g, '&quot;'); }
+
+    function endMin(r) { return maxCanon(todayCanon(), r.from ? addDays(r.from, 1) : ''); }
+
+    function holderCell(i, r) {
+      var items = HOLDER_OPTIONS.map(function (v) { return { value: v, label: v }; });
+      return '<sd-autocomplete size="sm" hideInlineError placeholder="Tìm theo tên hoặc email" data-holder-row="' + i + '" data-holder-field="holder"' +
+        ' items="' + escAttrH(JSON.stringify(items)) + '"' + (r.holder ? ' value="' + escAttrH(r.holder) + '"' : '') + '></sd-autocomplete>';
+    }
+    function dateCell(i, field, value, min, required, label) {
+      return '<sd-date size="sm" hideInlineError aria-label="' + label + '" data-holder-row="' + i + '" data-holder-field="' + field + '"' +
+        (required ? ' required' : '') + (min ? ' min="' + min + '"' : '') + (value ? ' value="' + value + '"' : '') + '></sd-date>';
+    }
+    function delCell(i) {
+      return '<sd-button type="light" color="primary" size="sm" prefixIcon="delete_outline" aria-label="Xóa dòng" data-holder-del="' + i + '"></sd-button>';
+    }
+    function renderHolderTable() {
+      var data = holderRows.map(function (r, i) {
+        return {
+          _holder: holderCell(i, r),
+          _from: dateCell(i, 'from', r.from, '', true, 'Ngày bắt đầu'),
+          _to: dateCell(i, 'to', r.to, endMin(r), false, 'Ngày kết thúc'),
+          _act: delCell(i)
+        };
+      });
+      document.getElementById('holder-table').setAttribute('data', JSON.stringify(data));
+    }
+
+    (function initHolderTable() {
+      var t = document.getElementById('holder-table');
+      t.addEventListener('sd-table-add-row', function () {
+        holderRows.push({ holder: '', from: '', to: '' });
+        renderHolderTable();
+      });
+      // Giá trị ô đổi: chỉ ghi vào state, không dựng lại bảng (giữ focus); đổi Ngày bắt đầu thì cập nhật `min` của Ngày kết thúc cùng dòng.
+      t.addEventListener('sd-change', function (e) {
+        var el = e.target, i = el.getAttribute && el.getAttribute('data-holder-row');
+        if (i == null) return;
+        var r = holderRows[+i], field = el.getAttribute('data-holder-field');
+        if (!r) return;
+        r[field] = (e.detail && e.detail.value) || '';
+        if (field === 'from') {
+          var toEl = t.querySelector('sd-date[data-holder-row="' + i + '"][data-holder-field="to"]');
+          if (toEl && toEl.getAttribute('min') !== endMin(r)) toEl.setAttribute('min', endMin(r));
+        }
+      });
+      t.addEventListener('click', function (e) {
+        var btn = e.target.closest('[data-holder-del]');
+        if (!btn) return;
+        holderRows.splice(+btn.getAttribute('data-holder-del'), 1);
+        renderHolderTable();
+      });
+      renderHolderTable();
+    })();
+  </script>
+
 </body>
