+// ── Tiện ích đọc/ghi items của sd-select / sd-autocomplete ───────────────────
+function wiItems(el) {
+  if (!el) return [];
+  try { var list = JSON.parse(el.getAttribute('items') || '[]'); return Array.isArray(list) ? list : []; }
+  catch (e) { return []; }
+}
+function wiSetItems(el, items) { if (el) el.setAttribute('items', JSON.stringify(items)); }
+/* items cho chuỗi markup: attribute bọc nháy kép, JSON đã thoát &quot; */
+function wiItemsAttr(items) { return 'items="' + escapeMockValue(JSON.stringify(items)) + '"'; }
+function wiHasItem(el, id) { return wiItems(el).some(function(item) { return String(item.id) === String(id); }); }
+/* Chữ đang hiển thị của sd-select (thay cho options[selectedIndex].textContent) */
+function wiSelectedName(el) {
+  if (!el) return '';
+  var v = String(el.value || '');
+  var found = wiItems(el).filter(function(item) { return String(item.id) === v; })[0];
+  return found ? String(found.name) : '';
+}
+function wiNameItems(list) { return list.map(function(name) { return { id: name, name: name }; }); }
+
+function escapeMockValue(value) {
+  return String(value).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
+}
+
+// ── Entry Condition Builder (Edit page) ───────────────────────
+var OP_ITEMS_EDIT = [
+  { id:'>', name:'> (lớn hơn)' },
