+  { id:'<', name:'< (nhỏ hơn)' },
+  { id:'<=', name:'<= (nhỏ hơn hoặc bằng)' },
+  { id:'=', name:'=  (bằng)' },
+  { id:'!=', name:'≠  (khác)' },
+  { id:'BETWEEN', name:'BETWEEN (trong khoảng)' },
+  { id:'IN', name:'IN (trong danh sách)' },
+  { id:'NOT IN', name:'NOT IN (ngoài danh sách)' }
+];
+var COND_CURRENCY_ITEMS = [{ id:'VND', name:'VND' }, { id:'USD', name:'USD' }];
+
+function condFieldIsDate(field) {
+  return !!field && /date|ngay|ngày/i.test((field.value || '') + ' ' + wiSelectedName(field));
+}
+
+/* Ô số tiền + đơn vị tiền tệ: sd-input-number (định dạng 1,234,567) + sd-select tiền tệ */
+function condNumberHtml(placeholder, value) {
+  return '<div class="val-with-currency">' +
+    '<sd-input-number class="cond-val-input" format="1,234,567.89" precision="0" type="positive" placeholder="' + escapeMockValue(placeholder) + '"' + (value ? ' value="' + escapeMockValue(value) + '"' : '') + '></sd-input-number>' +
+    '<sd-select class="cond-currency" placeholder="-" ' + wiItemsAttr(COND_CURRENCY_ITEMS) + '></sd-select>' +
+  '</div>';
+}
+function condDateHtml(placeholder) {
+  return '<sd-date class="cond-val-input"' + (placeholder ? ' placeholder="' + escapeMockValue(placeholder) + '"' : '') + '></sd-date>';
+}
+
+/* Ô Giá trị theo loại điều kiện + toán tử. noLabel: dòng điều kiện dạng gọn (Luồng 2) không có nhãn. */
+function renderCondValueCell(isDate, op, noLabel) {
+  var label = function(text) { return noLabel ? '' : '<label class="sd-label mb-0">' + text + '</label>'; };
+  var part = function(placeholder) {
+    return '<div class="form-field-group">' + (isDate ? condDateHtml(placeholder) : condNumberHtml(placeholder)) + '</div>';
+  };
+  if (op === 'BETWEEN') {
+    return label('Giá trị') +
+      '<div class="between-inputs">' + part('Từ') + '<span class="between-sep">→</span>' + part('Đến') + '</div>';
+  }
+  if (op === 'IN' || op === 'NOT IN') {
+    return label('Danh sách giá trị') +
+      '<sd-chip class="cond-val-input" placeholder="Nhập rồi nhấn Enter..."></sd-chip>' +
+      '<div class="form-hint">Nhấn Enter để xác nhận từng giá trị</div>';
+  }
+  return label('Giá trị') + (isDate ? condDateHtml('') : condNumberHtml('Nhập giá trị...'));
 }
 
