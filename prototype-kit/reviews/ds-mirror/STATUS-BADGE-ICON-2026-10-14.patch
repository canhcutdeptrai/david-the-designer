+
+  function extractResolveStackItems(html) {
+    var value = String(html || '').trim();
+    if (value.indexOf('resolve-stack') < 0) return [];
+    var host = document.createElement('div');
+    host.innerHTML = value;
+    return Array.prototype.slice.call(host.querySelectorAll('.resolve-stack > div')).map(function(item) {
+      return item.innerHTML || '-';
+    });
+  }
+
+  function stripResolveLabel(html) {
+    var host = document.createElement('div');
+    host.innerHTML = String(html || '-');
+    Array.prototype.slice.call(host.querySelectorAll('.resolve-tag')).forEach(function(tag) {
+      tag.remove();
+    });
+    return (host.textContent || '-').trim() || '-';
+  }
+
+  function escapeSnapshotText(value) {
+    return String(value || '-')
+      .replace(/&/g, '&amp;')
+      .replace(/</g, '&lt;')
+      .replace(/>/g, '&gt;')
+      .replace(/"/g, '&quot;')
+      .replace(/'/g, '&#39;');
+  }
+
+  function renderResolveLine(position, holder, runtimeNotes) {
+    var cleanPosition = stripResolveLabel(position);
+    var cleanHolder = stripResolveLabel(holder);
+    var isMissing = !cleanHolder || cleanHolder === '-';
+    var note = runtimeNotes && runtimeNotes[cleanHolder] ? '<span class="runtime-table-note">' + escapeSnapshotText(runtimeNotes[cleanHolder]) + '</span>' : '';
+    return '<div class="resolve-line' + (isMissing ? ' missing' : '') + '">' +
+      '<span class="resolve-line-position">' + escapeSnapshotText(cleanPosition) + '</span>' +
+      '<span class="resolve-line-holder">' + escapeSnapshotText(isMissing ? '-' : cleanHolder) + note + '</span>' +
+    '</div>';
+  }
+
+  function renderResolveHolderCell(resolveValue, holderValue, runtimeNotes) {
+    if (String(resolveValue || '').indexOf('resolve-pair-stack') >= 0) {
+      var host = document.createElement('div');
+      host.innerHTML = resolveValue;
+      var pairLines = Array.prototype.slice.call(host.querySelectorAll('.resolve-pair')).map(function(pair) {
+        return renderResolveLine(
+          pair.querySelector('.resolve-pair-position') ? pair.querySelector('.resolve-pair-position').innerHTML : '-',
+          pair.querySelector('.resolve-pair-holder') ? pair.querySelector('.resolve-pair-holder').innerHTML : '-',
+          runtimeNotes
+        );
+      });
+      return '<div class="resolve-line-stack">' + pairLines.join('') + '</div>';
+    }
+    var positions = extractResolveStackItems(resolveValue);
+    var holders = extractResolveStackItems(holderValue);
+    if (positions.length || holders.length) {
+      var size = Math.max(positions.length, holders.length);
+      var html = '';
+      for (var i = 0; i < size; i += 1) {
+        html += renderResolveLine(positions[i] || '-', holders[i] || '-', runtimeNotes);
+      }
+      return '<div class="resolve-line-stack">' + html + '</div>';
+    }
+    return '<div class="resolve-line-stack">' + renderResolveLine(resolveValue || '-', holderValue || '-', runtimeNotes) + '</div>';
+  }
