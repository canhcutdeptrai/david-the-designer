+  [/<sd-checkbox\b[^>]*\s(?:error|helperText|indeterminate|size)\b/i, 'sd-checkbox error / helperText / indeterminate / size', 'catalog không có — bỏ (lỗi / gợi ý viết dòng chữ riêng bên dưới)'],
