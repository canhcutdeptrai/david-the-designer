+/* báo cáo — không tự sửa */
+function report(s, st) {
+  const handHeader = /<div[^>]*class=["'][^"']*\bpage-header\b(?![\w-])[^"']*["']/.test(s) && !/data-pattern=["']page-header["']/.test(s);
+  if (handHeader) st.notes.push('header VIẾT TAY (Rule 10) — đã có lưới an toàn trong layout.css; nên đổi sang data-pattern="page-header"');
+  const tag = (s.match(/<sd-badge\b[^>]*\btype=["']tag["']/g) || []).length;
+  if (tag) st.notes.push(tag + ' sd-badge type="tag" — từ 2026-10-10 "tag" là khung viền 1px; muốn viên thuốc thì đổi sang type="round"');
+  const num = (s.match(/["']?type["']?\s*:\s*["']number["'](?![^}]*precision)(?![^}]*\})/g) || []).length;
+  if (num) st.notes.push(num + ' cột type number (object lồng) chưa khai option.precision — nay hiện 2 số lẻ như catalog; số nguyên thì thêm option.precision = 0');
+  for (const [rx, what, how] of GONE) {
+    const n = (s.match(new RegExp(rx.source, rx.flags.includes('g') ? rx.flags : rx.flags + 'g')) || []).length;
+    if (n) st.notes.push('còn ' + n + '× ' + what + ' → ' + how);
+  }
+  const foot = (s.match(/\sslot=\\?["']footer\\?["']/g) || []).length;
+  if (foot) st.notes.push(foot + '× slot="footer" — sd-side-drawer vẫn nhận; theo catalog nên đổi sang <div sdFooter class="d-flex align-items-center justify-content-end gap-8"> (sdFooter không tự căn phải; sd-modal chỉ nhận sdFooter)');
+}
+
+let total = { files: 0, skipped: 0 };
+for (const f of files) {
+  const src = fs.readFileSync(f, 'utf8');
+  const st = { spacing: {}, reset: 0, badge: 0, href: 0, precision: 0, slot: 0, label: 0, css: false, notes: [] };
+  if (src.includes(MARK)) { console.log('· ' + f + ' — đã migrate trước đó, bỏ qua'); total.skipped++; continue; }
+  const sign = OLD_SIGNS.find(([rx]) => rx.test(src));
+  if (!sign && !FORCE) { console.log('· ' + f + ' — không thấy dấu hiệu kit cũ (link Google Fonts Roboto, type="status", slot="header-right") → coi là trang mới, bỏ qua (thêm --force nếu chắc là trang cũ)'); total.skipped++; continue; }
+  let s = src;
+  s = remapSpacing(s, st);
+  s = fixStatusBadge(s, st);
+  s = fixButtonHref(s, st);
+  s = fixNumberPrecision(s, st);
+  s = fixSlots(s, st);
+  s = fixButtonLabel(s, st);
+  s = markReset(s, st);
+  s = linkLegacyCss(s, st);
+  report(s, st);
+  s = s.replace(/(<head[^>]*>)/i, '$1\n  <!-- ' + MARK + ' ' + TODAY + ' (ai-instructions/tools/migrate-prototype.mjs) -->');
+  const nSp = Object.values(st.spacing).reduce((a, b) => a + b, 0);
+  console.log('✓ ' + f + ' — khoảng cách ' + nSp + ' · reset ' + st.reset + ' thẻ · badge status ' + st.badge + ' · sd-button href ' + st.href + ' · cột số ' + st.precision +
+    ' · slot→sdHeader* ' + st.slot + ' · nhãn sd-button ' + st.label +
+    (st.css ? ' · nạp legacy-reset.css' : ''));
+  for (const n of st.notes) console.log('    ! ' + n);
+  if (!DRY && s !== src) {
+    const bak = path.join(path.dirname(f), '_pre-migrate'); fs.mkdirSync(bak, { recursive: true });
+    fs.writeFileSync(path.join(bak, path.basename(f)), src);
+    fs.writeFileSync(f, s);
+  }
+  total.files++;
+}
+console.log('\n' + total.files + ' trang ' + (DRY ? '(chạy thử, chưa ghi)' : 'đã nâng') + ' · ' + total.skipped + ' trang bỏ qua' +
+  (DRY || !total.files ? '' : ' · bản gốc ở _pre-migrate/'));
diff -ruN '--exclude=vendor' '--exclude=reviews' a/design-system/core/styles/legacy-reset.css b/design-system/core/styles/legacy-reset.css
--- a/design-system/core/styles/legacy-reset.css	1970-01-01 00:00:00.000000000 +0000
+++ b/design-system/core/styles/legacy-reset.css	2026-10-14 14:25:39.399590260 +0000
@@ -0,0 +1,53 @@
+/* ============================================================
+   LEGACY RESET — chỉ cho prototype sinh bằng kit CŨ (trước 2026-10-13)
+   ─────────────────────────────────────────────────────────────
+   Kit cũ reset `*{margin:0;padding:0}`: p / h1–h6 / ul / ol / label / button… của trang KHÔNG có lề, KHÔNG có
+   đệm. Từ 2026-10-13 kit dùng reboot của sd-core (Core UI): p lề dưới 16px, h* 8px, ul/ol thụt 40px + lề 16px,
+   label inline-block lề 8px, nút / ô nhập trần có đệm của trình duyệt. Trang cũ mở bằng kit mới vì vậy "vỡ":
+   chữ dãn, danh sách thụt vào, nút trần to ra.
+
+   File này KHÔNG nạp cho trang mới. `ai-instructions/tools/migrate-prototype.mjs` tự gắn nó vào trang cũ, và
+   đánh dấu `data-legacy-reset` lên đúng các thẻ do TRANG viết (không đụng phần bên trong `sd-*`).
+
+   Độ ưu tiên = đúng như `*{…}` cũ so với CSS của trang:
+     `p:where([data-legacy-reset])` = (0,0,1) — thắng reboot `p{…}` (file nạp SAU các file của kit),
+     hoà với luật thẻ của trang (trang đứng sau → trang thắng), thua mọi luật có lớp của trang.
+   Không khôi phục font / màu cũ — phần đó đã theo Core (nút / ô nhập trần kế thừa Roboto 14px). */
+p:where([data-legacy-reset]),
+h1:where([data-legacy-reset]), h2:where([data-legacy-reset]), h3:where([data-legacy-reset]),
+h4:where([data-legacy-reset]), h5:where([data-legacy-reset]), h6:where([data-legacy-reset]),
+dl:where([data-legacy-reset]), dd:where([data-legacy-reset]),
+figure:where([data-legacy-reset]), blockquote:where([data-legacy-reset]), pre:where([data-legacy-reset]),
+hr:where([data-legacy-reset]), legend:where([data-legacy-reset]) {
+  margin: 0;
+}
+ul:where([data-legacy-reset]), ol:where([data-legacy-reset]) {
+  margin: 0;
+  padding: 0;
+}
+label:where([data-legacy-reset]) {
+  margin: 0;
+  display: inline;
+}
+button:where([data-legacy-reset]), input:where([data-legacy-reset]), textarea:where([data-legacy-reset]),
+th:where([data-legacy-reset]), td:where([data-legacy-reset]) {
+  padding: 0;
+}
+table:where([data-legacy-reset]) {
+  border-collapse: separate;
+}
+
+/* Trang cũ bọc ô `sd-*` trong `div.sd-form-field` (lớp của markup viết tay — kit cũ dùng chung tên với ruột component).
+   Nay ô `sd-*` tự vẽ khung Material → hai khung chồng nhau, lệch dòng. Bỏ hình của lớp bọc, giữ nó làm khung bố cục
+   (luật flex / width của trang vẫn ăn). `height:auto !important` thắng `height:36px` trang từng ép cho vừa ô cũ. */
+.sd-form-field:has(> :is(sd-input, sd-select, sd-date, sd-datetime, sd-date-range, sd-autocomplete, sd-input-number,
+                          sd-textarea, sd-chip, sd-chip-calendar, sd-input-color)) {
+  display: block;
+  min-height: 0;
+  height: auto !important;
+  padding: 0;
+  border: 0;
+  background: none;
+  box-shadow: none;
+  cursor: auto;
+}
