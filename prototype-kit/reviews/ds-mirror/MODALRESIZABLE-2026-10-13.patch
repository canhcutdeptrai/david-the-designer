+<script>
+  // Wire the page's own page-tab-zone to tab panels
+  (function () {
+    function initPreviewTabs() {
+      var pageHeader = document.querySelector('.main-area > .page-header');
+      if (!pageHeader) return;
+      var tabZone = pageHeader.querySelector('.page-tab-zone');
+      if (!tabZone) return;
+      var tabs = tabZone.querySelectorAll('.tab');
+      var panels = document.querySelectorAll('.tab-panel[data-tab-panel]');
+
+      function showPanel(index) {
+        panels.forEach(function (p) {
+          p.style.display = parseInt(p.getAttribute('data-tab-panel'), 10) === index ? '' : 'none';
+        });
+        tabs.forEach(function (t, i) {
+          t.classList.toggle('active', i === index);
+        });
+      }
+
+      tabs.forEach(function (tab, i) {
+        tab.addEventListener('click', function () { showPanel(i); });
+      });
+
+      showPanel(0);
+    }
+    initPreviewTabs();
+  })();
+
+  (function () {
+    var log = document.getElementById('mr-event-log'), empty = 'Chưa có sự kiện nào.';
+    function line(t) { log.textContent = (log.textContent === empty ? '' : log.textContent + '\n') + t; }
+    ['sd-open', 'sd-close', 'sd-editing-changed'].forEach(function (n) {
+      document.addEventListener(n, function (e) {
+        if (!e.target.matches || !e.target.matches('sd-modal-resizable')) return;
+        line(n + ' #' + e.target.id + (e.detail ? ' ' + JSON.stringify(e.detail) : ''));
+      });
+    });
+    document.addEventListener('click', function (e) {
+      var b = e.target.closest && e.target.closest('[data-mr], [data-mr-close]');
+      if (!b) return;
+      if (b.hasAttribute('data-mr-close')) { document.getElementById(b.getAttribute('data-mr-close')).close(); return; }
+      document.getElementById(b.getAttribute('data-mr'))[b.getAttribute('data-mr-call')]();
+    });
+    document.getElementById('btn-mr-loading').addEventListener('click', function () {
+      var hs = document.getElementById('mr-hs');
+      hs.open(); hs.startLoading();
+      setTimeout(function () { hs.stopLoading(); }, 2000);
+    });
+    document.getElementById('btn-mr-close-all').addEventListener('click', function () {
+      document.getElementById('mr-hs').close(); document.getElementById('mr-kv').close();
+    });
+  })();
