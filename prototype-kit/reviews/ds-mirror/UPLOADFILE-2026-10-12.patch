+/* PreviewComponent (`preview()`) — nguyên văn CSS catalog `#c-upload-file`
+   (.image-gallery …), phạm vi `.sd-upload-preview` vì modal gắn ở <body>.
+   Catalog đặt chiều cao 60vh (demo cố định 360px — đây lấy 60vh của bản gốc). */
+.sd-upload-preview { overflow: hidden; height: 100%; }
+.sd-upload-preview .image-gallery { display: flex; gap: 8px; width: 100%; max-height: 60vh; min-height: 60vh; }
+.sd-upload-preview .image-gallery .main-image-container { flex: 1; position: relative; background-color: var(--sd-black100); display: flex; justify-content: center; align-items: center; flex-direction: column; gap: 8px; }
+.sd-upload-preview .image-gallery .main-image-container .next-icon { position: absolute; top: 45%; right: 8px; cursor: pointer; color: rgba(0, 0, 0, .54); z-index: 9999; }
+.sd-upload-preview .image-gallery .main-image-container .back-icon { position: absolute; top: 45%; left: 8px; cursor: pointer; color: rgba(0, 0, 0, .54); z-index: 9999; }
+.sd-upload-preview .image-gallery .thumbnail-container { width: 120px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; box-sizing: border-box; }
+.sd-upload-preview .image-gallery .thumbnail-wrapper { position: relative; width: 100px; aspect-ratio: 1; flex: 0 0 auto; overflow: hidden; padding: 0; border: none; background: transparent; cursor: pointer; }
+/* catalog tô thumbnail đang chọn bằng inline style `border: 2px solid rgb(41, 98, 255)` */
+.sd-upload-preview .image-gallery .thumbnail-wrapper.c-active { border: 2px solid #2962ff; }
+.sd-upload-preview .image-gallery .thumbnail-wrapper .thumbnail-img { object-fit: cover; width: 100%; height: 100%; display: block; }
+.sd-upload-preview .image-gallery .main-image { object-fit: contain; width: 100%; height: 100%; display: block; }
+.sd-upload-preview .image-gallery .main-document { object-fit: contain; height: 64px; width: 64px; display: block; }
+.sd-upload-preview .file { padding: 5px; }
+.sd-upload-preview .image-gallery .file { padding: 4px; }
 
