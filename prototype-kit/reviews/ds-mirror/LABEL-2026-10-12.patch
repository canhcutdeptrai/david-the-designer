+/* Kiểu `matTooltip` (Angular Material 20, token M2 của catalog `#c-label`) —
+   dùng cho tooltip của icon gợi ý sd-label (`data-sd-tooltip-kind="mat"`).
+   Khác bong bóng sdTooltip ở MỌI số đo: nền #424242 (không phải #616161),
+   đệm 4px 8px, rộng tối đa 200px (không 250), cao tối thiểu 24px, chữ 12px/16px
+   giãn 0.025rem, CĂN GIỮA, KHÔNG bóng đổ, không nhận chuột; hiện bằng hiệu ứng
+   phóng .8 → 1 trong 150ms. Rà soát 2026-10-12. */
+.sd-tooltip.sd-tooltip--mat {
+  background: #424242;
+  padding: 4px 8px;
+  min-width: 40px;
+  max-width: 200px;
+  min-height: 24px;
+  max-height: 40vh;
+  box-sizing: border-box;
+  overflow: hidden;
+  box-shadow: none;
+  border-radius: 4px;
+  font-size: 12px;
+  line-height: 16px;
+  letter-spacing: 0.025rem;
+  text-align: center;
+  word-break: normal;
+  overflow-wrap: anywhere;
+  pointer-events: none;
+}
+.sd-tooltip.sd-tooltip--mat.sd-tooltip-visible {
+  animation: sd-mat-tooltip-show 150ms cubic-bezier(0, 0, .2, 1) forwards;
+}
+@keyframes sd-mat-tooltip-show { 0% { opacity: 0; transform: scale(.8); } 100% { opacity: 1; transform: scale(1); } }
