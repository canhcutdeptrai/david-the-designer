diff -ruN '--exclude=vendor' '--exclude=reviews' a/design-system/core/styles/legacy-reset.css b/design-system/core/styles/legacy-reset.css
--- a/design-system/core/styles/legacy-reset.css	2026-10-14 15:21:50.557730475 +0000
+++ b/design-system/core/styles/legacy-reset.css	2026-10-14 16:37:36.477307577 +0000
@@ -57,3 +57,44 @@
 .d-flex:is([style*="display: none"], [style*="display:none"]) {
   display: none !important;
 }
+
+/* Ô nhập tự dựng đã đổi sang sd-* (migrate-prototype bước 14): lớp CSS của trang từng vẽ viền / đệm / nền cho ô trần nay
+   rơi lên host → khung đôi. Bỏ phần HÌNH của các lớp đó trên host; bề rộng / lề / flex của trang vẫn ăn. */
+:is(sd-input, sd-input-number, sd-select, sd-textarea, sd-date, sd-datetime, sd-date-range, sd-autocomplete)[data-legacy-ctl] {
+  border: 0 !important;
+  padding: 0 !important;
+  background: none !important;
+  box-shadow: none !important;
+  outline: 0 !important;
+  height: auto !important;
+  min-height: 0 !important;
+  border-radius: 0 !important;
+  font: inherit;
+}
+/* `<button class="toggle">` (kit cũ) đã thành sd-switch: lớp .toggle của components.css không vẽ lên host nữa */
+sd-switch[data-legacy-toggle] {
+  position: static !important;
+  width: auto !important;
+  height: auto !important;
+  background: none !important;
+  border-radius: 0 !important;
+  border: 0 !important;
+  padding: 0 !important;
+  transform: none !important;
+}
+sd-switch[data-legacy-toggle]::after { content: none !important; }
+
+/* Modal / drawer viết tay đã thành sd-modal / sd-side-drawer: lớp của trang còn giữ trên host (móc JS) không được vẽ lại
+   hình hộp cũ / bật hiện host — hiện / ẩn chỉ do component quyết định. */
+sd-modal[data-legacy-modal] { display: contents !important; }
+sd-side-drawer[data-legacy-modal] {
+  position: fixed !important; inset: 0 !important; width: auto !important; height: auto !important; max-width: none !important;
+  background: none !important; box-shadow: none !important; border: 0 !important; border-radius: 0 !important;
+  padding: 0 !important; margin: 0 !important; transform: none !important; opacity: 1 !important;
+}
+sd-side-drawer[data-legacy-modal]:not(.sd-side-drawer-mounted):not(.sd-side-drawer-active) { display: none !important; }
+sd-side-drawer[data-legacy-modal]:is(.sd-side-drawer-mounted, .sd-side-drawer-active) { display: flex !important; }
+
+/* <select data-legacy-upgrade> (option dựng bằng JS): select gốc chỉ còn là nguồn dữ liệu cho JS cũ — legacy-shim.js vẽ
+   <sd-select> Core ngay trước nó. JS cũ có bật style.display của select cũng không hiện lại ô trần. */
+select[data-legacy-proxied] { display: none !important; }
